<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#181A20">

    <!-- Header: Plataforma + Semáforo / Badge de Viabilidade -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_platform"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notif_button"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="UBER"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_notif_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="VIÁVEL"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="★ 4.95"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Linha principal: Valor (R$), Distância (km), Tempo (min) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_fare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 24,50"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="#757575"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/notif_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7,2 km"
            android:textColor="#ECEFF1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="#757575"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/notif_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 min"
            android:textColor="#CFD8DC"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Linha econômica: Lucro líquido, R$/km, R$/h -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_profit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lucro R$ 16,80"
            android:textColor="#00E676"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            android:textColor="#757575"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notif_rates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 2,33/km · R$ 56,0/h"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Endereço de Embarque (opcional) -->
    <LinearLayout
        android:id="@+id/notif_pickup_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notif_pickup_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Av. Paulista, 1000"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Endereço de Destino (opcional) -->
    <LinearLayout
        android:id="@+id/notif_dest_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏁 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/notif_dest_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="R. Augusta, 500"
            android:textColor="#ECEFF1"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Botões de Ação para Google Maps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/notif_btn_pickup"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_notif_button"
            android:text="📍 Embarque"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/notif_btn_dest"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_notif_button"
            android:text="🏁 Destino"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
